# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Resend (https://resend.com) — leave RESEND_API_KEY blank in local dev to log
# enquiries to the console instead of sending real emails.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Artville Website <onboarding@resend.dev>"
# TODO: replace with the real inbox the business wants enquiries sent to
CONTACT_TO_EMAIL=owner@example.com

# Contact form rate limiting (per IP)
CONTACT_RATE_LIMIT_WINDOW_MINUTES=15
CONTACT_RATE_LIMIT_MAX_REQUESTS=5
